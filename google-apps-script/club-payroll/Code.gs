// 從現有 Google 試算表開啟「擴充功能 > Apps Script」，貼入本檔。
// 第一次執行 setupPayroll，執行記錄會顯示共用存取碼；再部署為網頁應用程式（執行身分：我，存取：任何人）。
const LABELS = {P:'出席',A:'請假',U:'待登記'};
const CODES = {'出席':'P','請假':'A','待登記':'U'};


function setupPayroll(){const sheet=SpreadsheetApp.getActiveSpreadsheet();if(!sheet||!sheet.getSheetByName('出席紀錄'))throw Error('請從正確的試算表開啟 Apps Script');const p=PropertiesService.getScriptProperties();p.setProperty('SHEET_ID',sheet.getId());if(!p.getProperty('ACCESS_CODE'))p.setProperty('ACCESS_CODE',Utilities.getUuid().replace(/-/g,'').slice(0,24));console.log('共用存取碼：'+p.getProperty('ACCESS_CODE'));}
function isAuthorized_(token){const expected=PropertiesService.getScriptProperties().getProperty('ACCESS_CODE');return !!expected&&token===expected;}
function doGet(){return HtmlService.createHtmlOutput(PAGE_HTML).setTitle('社團鐘點費管理').addMetaTag('viewport','width=device-width, initial-scale=1');}
function payrollRequest(req) {
  if (!req || typeof req.token !== 'string' || !isAuthorized_(req.token)) return {ok:false,error:'共用網址授權無效'};
  if (!['get','save'].includes(req.action)) return {ok:false,error:'不支援的操作'};
  const lock=LockService.getScriptLock();
  if (!lock.tryLock(10000)) return {ok:false,error:'有其他人正在儲存，請稍後重試'};
  try {
    const sheet=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID')).getSheetByName('出席紀錄');
    if (!sheet) throw new Error('找不到出席紀錄工作表');
    const current=readRecords_(sheet), revision=revision_(current), names=sheet.getRange(1,3,1,3).getDisplayValues()[0];
    if(req.action==='get') return {ok:true,records:current,revision,names};
    if(req.revision!==revision) return {ok:false,error:'紀錄已由其他人更新，請重新確認再操作'};
    const next=normalize_(req.records);
    writeRecords_(sheet,next);
    SpreadsheetApp.flush();
    const confirmed=readRecords_(sheet);
    return {ok:true,records:confirmed,revision:revision_(confirmed),names};
  } catch(err) {return {ok:false,error:String(err.message||'無法完成資料庫操作').slice(0,180)};}
  finally {lock.releaseLock();}
}
function normalize_(records) {
  if(!Array.isArray(records)||records.length>500) throw new Error('紀錄數量不合法（上限 500 堂）');
  const seen=new Set();
  return records.map(r=>{
    if(!r||typeof r.date!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(r.date)||seen.has(r.date)) throw new Error('日期格式不合法或重複');
    const d=new Date(r.date+'T00:00:00Z');
    if(isNaN(d)||d.toISOString().slice(0,10)!==r.date) throw new Error('日期不合法');
    if(!Number.isInteger(r.rate)||r.rate<0||r.rate>1000000||!Array.isArray(r.status)||r.status.length!==3||!r.status.every(x=>['P','A','U'].includes(x))||typeof r.off!=='boolean') throw new Error('鐘點費或出席狀態不合法');
    const note=typeof r.note==='string'?r.note.slice(0,100):'';
    if(/^\s*[=+@-]/.test(note)) throw new Error('備註不可使用公式開頭');
    seen.add(r.date);return {date:r.date,rate:r.rate,status:r.status.slice(),off:r.off,note};
  }).sort((a,b)=>a.date.localeCompare(b.date));
}
function readRecords_(sheet) {
  const last=sheet.getLastRow();
  if(last<2)return [];
  return normalize_(sheet.getRange(2,1,last-1,7).getValues().filter(r=>r[0]!==''&&r[0]!==null).map(r=>({
    date:r[0] instanceof Date?Utilities.formatDate(r[0],'Asia/Taipei','yyyy-MM-dd'):String(r[0]),
    rate:r[1],status:r.slice(2,5).map(s=>CODES[s]),off:r[5]==='是',note:String(r[6]||'')
  })));
}
function revision_(records) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(records),Utilities.Charset.UTF_8).map(n=>('0'+((n+256)%256).toString(16)).slice(-2)).join('');
}
function writeRecords_(sheet,records) {
  const n=Math.max(sheet.getLastRow()-1,records.length);
  if(!n)return;
  if(sheet.getMaxRows()<n+1)sheet.insertRowsAfter(sheet.getMaxRows(),n+1-sheet.getMaxRows());
  const rows=Array.from({length:n},(_,i)=>{
    const r=records[i];if(!r)return Array(11).fill('');
    const j=i+2;
    const formulas=['C','D','E'].map(c=>`=IF(OR($F${j}="是",COUNTIF($C${j}:$E${j},"待登記")>0,COUNTIF($C${j}:$E${j},"出席")=0,${c}${j}<>"出席"),0,QUOTIENT($B${j},COUNTIF($C${j}:$E${j},"出席"))+IF(COUNTIF($C${j}:${c}${j},"出席")<=MOD($B${j},COUNTIF($C${j}:$E${j},"出席")),1,0))`);
    return [r.date,r.rate,...r.status.map(s=>LABELS[s]),r.off?'是':'否',r.note,...formulas,`=LEFT(A${j},7)`];
  });
  sheet.getRange(2,1,n,1).setNumberFormat('@');
  sheet.getRange(2,1,n,11).setValues(rows);
}

const PAGE_HTML = "<!DOCTYPE html>\n<html lang=\"zh-Hant\">\n<head>\n<meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#f5f7f4\">\n<title>社團鐘點費管理</title>\n<style>\n:root{--bg:#f4f6f2;--paper:#fff;--ink:#20362f;--muted:#63736a;--line:#dce5dd;--green:#226548;--soft:#e4f1e8;--gold:#91601e;--goldbg:#fff1db;--red:#a44747;--redbg:#fae8e7;--radius:18px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,\"Noto Sans TC\",\"Microsoft JhengHei\",sans-serif;font-size:15px;line-height:1.55}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #8abf9a;outline-offset:2px}button{border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);padding:8px 13px}button:hover{border-color:var(--green)}button.primary{background:var(--green);color:white;border-color:var(--green)}button:disabled{opacity:.45;cursor:default}main{max-width:1080px;margin:auto;padding:24px 18px 48px}header{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:8px 0 24px}.eyebrow{font-weight:700;font-size:12px;letter-spacing:.15em;color:var(--green)}h1{font-size:clamp(26px,5vw,38px);line-height:1.15;letter-spacing:-.035em;margin:5px 0 8px}h2{font-size:20px;margin:0}p{margin:0}.muted{color:var(--muted);font-size:13px}.save{white-space:nowrap;color:var(--green);font-size:12px;display:flex;align-items:center;gap:7px}.dot{width:8px;height:8px;border-radius:50%;background:#3e9865}.hero{border-radius:var(--radius);background:#244c39;color:white;padding:22px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.hero .muted{color:#d6e6dc}.hero strong{font-size:36px;letter-spacing:-.04em;display:block;font-variant-numeric:tabular-nums}.hero .details{display:flex;gap:26px}.hero .details b{font-size:21px;display:block}.section{margin-top:24px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap}.tabs{display:flex;gap:7px;overflow-x:auto;padding:2px 1px 8px;scrollbar-width:thin}.tabs button{white-space:nowrap;flex:1;min-width:78px;font-weight:650}.tabs button[aria-selected=true]{background:var(--green);color:white;border-color:var(--green)}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.person{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:16px}.person .name{display:flex;gap:9px;align-items:center;font-weight:700}.avatar{display:grid;place-items:center;width:31px;height:31px;border-radius:10px;background:var(--soft);color:var(--green);font-weight:750}.person:nth-child(2) .avatar{background:#e7edf8;color:#45649c}.person:nth-child(3) .avatar{background:#f8ead9;color:#93662c}.person strong{font-size:clamp(21px,4vw,30px);display:block;letter-spacing:-.05em;margin:10px 0 4px;font-variant-numeric:tabular-nums}.person .muted{font-size:12px}.bar{height:5px;background:var(--line);border-radius:10px;overflow:hidden;margin-top:13px}.bar span{display:block;height:100%;background:#4f916c;border-radius:10px}.panel{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.panel-head{padding:15px 17px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{text-align:center;border-top:1px solid var(--line);padding:12px 8px;vertical-align:middle}th{background:#f5f8f5;color:#51655a;font-size:12px;white-space:nowrap}th:first-child,td:first-child{text-align:left;padding-left:16px;white-space:nowrap}th:last-child,td:last-child{padding-right:13px}td.date b{display:block;font-size:15px}td.date small{display:block;color:var(--muted);font-size:11px}.status{width:100%;max-width:91px;min-width:48px;border:0;border-radius:8px;padding:8px 4px;font-size:13px;font-weight:700;white-space:nowrap;background:#edf0ed;color:#68766d}.status.present{background:var(--soft);color:#226548}.status.absent{background:var(--redbg);color:var(--red)}.status.pending{background:#edf0ed;color:#68766d}.amount{display:block;font-size:12px;color:var(--muted);margin-top:4px;white-space:nowrap}.state{display:inline-block;padding:3px 8px;border-radius:7px;font-size:12px;white-space:nowrap;background:var(--goldbg);color:var(--gold)}.state.done{background:var(--soft);color:var(--green)}.state.off{background:#ecefed;color:var(--muted)}.rate{width:75px;text-align:right;border:1px solid var(--line);border-radius:7px;padding:5px 3px;background:white;color:var(--ink)}.rate:disabled{background:#f3f4f3}.iconbtn{font-size:19px;line-height:1;padding:6px 9px}.row-actions{display:flex;gap:5px;justify-content:center;align-items:center}.row-actions button{font-size:12px;padding:5px 8px}tr.cancelled{background:#f8f9f8}tfoot td{background:#f1f6f1;font-weight:750}.footnote{padding:12px 16px;background:#fafbf9;color:var(--muted);font-size:12px}.tools{display:flex;gap:8px;flex-wrap:wrap}.hint{margin:12px 0;color:var(--muted);font-size:13px}.notice{padding:12px 14px;background:#fdf7e9;border:1px solid #efdfb9;border-radius:12px;color:#735519;font-size:13px;margin-top:12px}.rule{display:flex;gap:8px;flex-wrap:wrap;font-size:12px;color:var(--muted)}.rule span{padding:5px 9px;border:1px solid var(--line);border-radius:8px;background:white}.modal{border:1px solid var(--line);border-radius:18px;padding:22px;width:min(94vw,420px);color:var(--ink)}.modal::backdrop{background:#1b332b70}.modal h2{margin-bottom:12px}.modal label{display:block;margin:12px 0 4px;font-weight:650;font-size:13px}.modal input,.modal select{width:100%;padding:10px;border:1px solid var(--line);border-radius:9px}.modal .tools{justify-content:flex-end;margin-top:18px}.error{color:var(--red);font-size:13px}.footer{margin-top:24px;color:var(--muted);font-size:12px}.empty{padding:32px;text-align:center;color:var(--muted)}@media(max-width:600px){main{padding:17px 10px 36px}header{padding:0 4px;align-items:flex-start}.save{font-size:10px;margin-top:4px}.hero{padding:16px}.hero strong{font-size:30px}.hero .details{gap:16px}.hero .details b{font-size:18px}.cards{gap:6px}.person{padding:10px 8px;border-radius:13px}.person .name{gap:5px;font-size:13px}.avatar{width:23px;height:23px;font-size:12px}.person strong{font-size:21px}.person .muted{font-size:10px}.panel-head{padding:12px 10px}th,td{padding:9px 4px}th:first-child,td:first-child{padding-left:9px}th:last-child,td:last-child{padding-right:8px}.rate{width:65px;font-size:12px}.status{font-size:12px;padding:7px 2px}.state{font-size:10px;padding:3px 5px}.amount{font-size:10px}.row-actions{flex-direction:column;gap:4px}.row-actions button{padding:3px 5px;font-size:10px}table{min-width:510px}.section{margin-top:19px}}\n[hidden]{display:none!important}</style>\n</head><body><main>\n<header><div><div class=\"eyebrow\">CLUB PAYROLL · 115 學年度上學期</div><h1>社團鐘點費管理</h1><p class=\"muted\"><span id=\"nameIntro\">共用出席紀錄</span>｜出席登記與薪資結算</p></div><div id=\"save\" class=\"save\"><span class=\"dot\"></span>等待雲端連線</div></header>\n<section id=\"login\" class=\"panel\" style=\"padding:22px\"><h2>共用資料庫登入</h2><p class=\"muted\" style=\"margin:10px 0\">輸入由管理者提供的共用存取碼。三位老師共用同一份雲端紀錄。</p><form id=\"loginForm\" class=\"tools\"><input type=\"password\" id=\"accessCode\" placeholder=\"共用存取碼\" required autocomplete=\"current-password\" style=\"padding:10px;border:1px solid #dce5dd;border-radius:9px\"><button class=\"primary\" type=\"submit\">連線</button></form><p id=\"loginError\" class=\"error\" style=\"margin-top:10px\"></p></section><div id=\"live\" hidden><div class=\"notice\" id=\"syncInfo\">雲端同步中</div><div class=\"tools\" style=\"margin:10px 0\"><button id=\"reloadCloud\">立即同步</button><button id=\"logout\">登出</button></div><section class=\"hero\" aria-label=\"全期總覽\"><div><p class=\"muted\">全期已結算鐘點費</p><strong id=\"grand\">$0</strong></div><div class=\"details\"><div><p class=\"muted\">已結算</p><b id=\"completed\">0 堂</b></div><div><p class=\"muted\">待登記</p><b id=\"pending\">0 堂</b></div><div><p class=\"muted\">停課</p><b id=\"off\">0 堂</b></div></div></section>\n<section class=\"section\"><div class=\"section-head\"><h2>薪資總覽</h2><div class=\"rule\"><span>3 人 $640／人</span><span>2 人 $960／人</span><span>1 人 $1,920</span></div></div><nav class=\"tabs\" id=\"tabs\" aria-label=\"月份選擇\"></nav><div class=\"cards\" id=\"cards\"></div></section>\n<section class=\"section panel\"><div class=\"panel-head\"><div><h2 id=\"tabletitle\">出席登記</h2><p class=\"muted\">點選個人狀態，切換待登記、出席、請假。</p></div><div class=\"tools\"><button id=\"allPresent\">本月待登記全員出席</button><button class=\"primary\" id=\"add\">＋ 新增日期</button></div></div><div class=\"tablewrap\"><table><thead><tr><th>上課日期</th><th>鐘點費</th><th data-name=\"0\">A</th><th data-name=\"1\">B</th><th data-name=\"2\">C</th><th>結算／操作</th></tr></thead><tbody id=\"rows\"></tbody><tfoot id=\"totals\"></tfoot></table></div><div class=\"footnote\">三人皆完成登記且至少一人出席，才計入已結算薪資。請假者不分配；當天餘額由出席者均分。全員請假不會自動視為已結算，請確認是否停課。</div></section>\n<div class=\"notice\" id=\"initialNote\">歷史紀錄按照片中的 V／空白重新核算。10 月單月金額已重新核算；照片中的舊結算列與逐日出席紀錄不符，未沿用舊結算數字。</div>\n<section class=\"section panel\"><div class=\"panel-head\"><div><h2>全期月結明細</h2><p class=\"muted\">每月僅統計已完成登記的課程。</p></div><button id=\"csv\">下載薪資 CSV</button></div><div class=\"tablewrap\"><table><thead><tr><th>月份</th><th>已結算堂數</th><th data-name=\"0\">A</th><th data-name=\"1\">B</th><th data-name=\"2\">C</th><th>合計</th></tr></thead><tbody id=\"summary\"></tbody><tfoot id=\"summaryTotal\"></tfoot></table></div></section>\n<section class=\"section panel\"><div class=\"panel-head\"><div><h2>資料備份</h2><p class=\"muted\">正式資料儲存在 Google 試算表；所有裝置讀取同一份紀錄。</p></div><div class=\"tools\"><button id=\"backup\">匯出備份</button><button id=\"restore\">匯入備份</button><input id=\"file\" type=\"file\" accept=\".json,application/json\" hidden><button id=\"reset\" hidden>還原初始紀錄</button></div></div><div class=\"footnote\">建議每月結算後匯出 JSON 備份。CSV 可用 Excel 開啟。</div></section>\n<p class=\"footer\">預設每堂 NT$1,920，可逐堂調整。2026 年 12 月 3、10、17、24、31 日及 2027 年 1 月 7 日均預排為待登記，可依實際校務行事曆停課或修改。</p>\n</div></main>\n<dialog class=\"modal\" id=\"editor\"><form id=\"editform\"><h2 id=\"edtitle\">新增上課日期</h2><label for=\"date\">日期</label><input type=\"date\" id=\"date\" required><label for=\"rate\">當天鐘點費（元）</label><input type=\"number\" id=\"rate\" min=\"0\" max=\"1000000\" step=\"1\" required value=\"1920\"><label for=\"note\">備註（選填）</label><input id=\"note\" maxlength=\"100\" placeholder=\"例如：校務活動、補課\"><p id=\"editerror\" class=\"error\" role=\"alert\"></p><div class=\"tools\"><button type=\"button\" id=\"closeedit\">取消</button><button type=\"submit\" class=\"primary\">儲存</button></div></form></dialog>\n<script>\n'use strict';\nlet names=['A','B','C'],token='',revision='',confirmed=[],connected=false,busy=false,reading=false;const seed=()=>[];\nconst $=id=>document.getElementById(id);const money=n=>n.toLocaleString('zh-TW');const esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction validDate(s){if(typeof s!=='string'||!/^\\d{4}-\\d{2}-\\d{2}$/.test(s))return false;const d=new Date(s+'T00:00:00Z');return !isNaN(d)&&d.toISOString().slice(0,10)===s;}\nfunction normalize(a){if(!Array.isArray(a))throw Error('備份格式錯誤');const seen=new Set();return a.map(r=>{if(!r||!validDate(r.date)||seen.has(r.date)||!Number.isInteger(r.rate)||r.rate<0||r.rate>1000000||!Array.isArray(r.status)||r.status.length!==3||!r.status.every(x=>['P','A','U'].includes(x))||typeof r.off!=='boolean')throw Error('備份含有不合法或重複紀錄');seen.add(r.date);return {date:r.date,rate:r.rate,status:[...r.status],off:r.off,note:typeof r.note==='string'?r.note.slice(0,100):''};}).sort((a,b)=>a.date.localeCompare(b.date));}\nlet data=[],selected='2026-12',editing=null;\nfunction rpc(action,extra={}){return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(v=>v&&v.ok?resolve(v):reject(Error(v?.error||'無效回應'))).withFailureHandler(e=>reject(Error(e?.message||'雲端連線失敗'))).payrollRequest({action,token,...extra}));}\nfunction msg(s,ok=false){$('syncInfo').textContent=s;$('save').textContent=ok?'Google 雲端已同步':'雲端尚未確認';}\nfunction controls(){const locked=!connected||busy;document.querySelectorAll('#rows button,#rows input,#add,#allPresent,#restore,#editform button[type=submit]').forEach(el=>{if(locked)el.disabled=true;});$('add').disabled=locked;$('restore').disabled=locked;$('editform').querySelector('button[type=submit]').disabled=locked;}\nfunction apply(v){const next=normalize(v.records);if(!Array.isArray(v.names)||v.names.length!==3||!v.names.every(n=>typeof n==='string'&&/^[\\p{L}\\p{N} _-]{1,20}$/u.test(n)))throw Error('人員欄位格式錯誤');names=v.names;data=next;confirmed=JSON.parse(JSON.stringify(data));revision=v.revision;connected=true;}\nasync function refresh(){if(!token||busy||reading||$('editor').open)return;reading=true;try{const rev=revision,v=await rpc('get');if(busy||rev!==revision||!token)return;const changed=!connected||rev!==v.revision;apply(v);msg('已連線｜每 15 秒同步雲端紀錄',true);if(changed)render();}catch(e){connected=false;msg('同步失敗：'+e.message);render();}finally{reading=false;}}\n$('loginForm').onsubmit=async e=>{e.preventDefault();if(busy)return;token=$('accessCode').value.trim();busy=true;$('loginError').textContent='連線中…';try{apply(await rpc('get'));$('login').hidden=true;$('live').hidden=false;$('accessCode').value='';msg('已連線｜每 15 秒同步雲端紀錄',true);}catch(e){token='';$('loginError').textContent=e.message;}finally{busy=false;if(connected)render();}};\n$('reloadCloud').onclick=refresh;$('logout').onclick=()=>{if(busy||reading)return;location.reload();};setInterval(refresh,15000);\nfunction state(r){return r.off?'off':r.status.includes('U')||!r.status.includes('P')?'pending':'done';}\nfunction shares(r){if(state(r)!=='done')return [0,0,0];const n=r.status.filter(x=>x==='P').length;const base=Math.floor(r.rate/n);let rem=r.rate%n;return r.status.map(x=>x==='P'?base+(rem-->0?1:0):0);}\nfunction stats(rows){const sum=[0,0,0],present=[0,0,0],absent=[0,0,0];let done=0,pending=0,off=0;for(const r of rows){const s=state(r);if(s==='done'){done++;shares(r).forEach((v,i)=>sum[i]+=v);}else if(s==='off')off++;else pending++;if(!r.off)r.status.forEach((v,i)=>{if(v==='P')present[i]++;if(v==='A')absent[i]++;});}return {sum,present,absent,done,pending,off,total:sum.reduce((a,b)=>a+b,0)};}\nfunction months(){return [...new Set(['2026-09','2026-10','2026-11','2026-12','2027-01',...data.map(r=>r.date.slice(0,7))])].sort();}\nfunction monthLabel(m){return `${m.slice(0,4)} 年 ${Number(m.slice(5))} 月`;}\nfunction filtered(m){return m==='all'?data:data.filter(r=>r.date.startsWith(m));}\nfunction render(){document.querySelectorAll('[data-name]').forEach(el=>el.textContent=names[Number(el.dataset.name)]);$('nameIntro').textContent=names.join('、');const g=stats(data);$('grand').textContent='$'+money(g.total);$('completed').textContent=g.done+' 堂';$('pending').textContent=g.pending+' 堂';$('off').textContent=g.off+' 堂';$('tabs').innerHTML=[...months(),'all'].map(m=>`<button data-month=\"${m}\" aria-selected=\"${selected===m}\">${m==='all'?'全期累計':Number(m.slice(5))+' 月'}</button>`).join('');const rows=filtered(selected),s=stats(rows);$('cards').innerHTML=names.map((n,i)=>`<article class=\"person\"><div class=\"name\"><span class=\"avatar\">${n[0]}</span>${n}</div><strong>$${money(s.sum[i])}</strong><div class=\"muted\">出席 ${s.present[i]} 次 · 請假 ${s.absent[i]} 次</div><div class=\"bar\"><span style=\"width:${s.total?100*s.sum[i]/Math.max(...s.sum):0}%\"></span></div></article>`).join('');$('tabletitle').textContent=(selected==='all'?'全期':monthLabel(selected))+'出席登記';$('allPresent').disabled=!rows.some(r=>!r.off&&r.status.includes('U'));$('allPresent').textContent=selected==='all'?'全期待登記全員出席':'本月待登記全員出席';const labels={P:'出席',A:'請假',U:'待登記'},classes={P:'present',A:'absent',U:'pending'};$('rows').innerHTML=rows.length?rows.map(r=>{const st=state(r),a=shares(r),d=new Date(r.date+'T00:00:00Z'),day=['日','一','二','三','四','五','六'][d.getUTCDay()];return `<tr class=\"${r.off?'cancelled':''}\"><td class=\"date\"><b>${Number(r.date.slice(5,7))}/${Number(r.date.slice(8))}</b><small>${r.date.slice(0,4)}・週${day}</small>${r.note?`<small title=\"${esc(r.note)}\">${esc(r.note.length>12?r.note.slice(0,12)+'…':r.note)}</small>`:''}</td><td><input class=\"rate\" aria-label=\"${r.date} 鐘點費\" type=\"number\" min=\"0\" max=\"1000000\" step=\"1\" value=\"${r.rate}\" data-rate=\"${r.date}\" ${r.off?'disabled':''}></td>${r.status.map((v,i)=>`<td><button class=\"status ${classes[v]}\" data-date=\"${r.date}\" data-person=\"${i}\" aria-label=\"${r.date} ${names[i]} ${labels[v]}，點擊切換\" ${r.off?'disabled':''}>${labels[v]}</button><span class=\"amount\">${st==='done'?'$'+money(a[i]):'—'}</span></td>`).join('')}<td><span class=\"state ${st}\">${st==='done'?'已結算':st==='off'?'停課':r.status.every(x=>x==='A')?'全員請假':'待登記'}</span><div class=\"row-actions\"><button data-edit=\"${r.date}\">編輯</button><button data-off=\"${r.date}\">${r.off?'復課':'停課'}</button></div></td></tr>`;}).join(''):'<tr><td colspan=\"6\" class=\"empty\">此月份尚無課程，按「新增日期」登記。</td></tr>';$('totals').innerHTML=`<tr><td>合計</td><td>${s.done} 堂</td>${s.sum.map(v=>'<td>$'+money(v)+'</td>').join('')}<td>$${money(s.total)}</td></tr>`;$('summary').innerHTML=months().map(m=>{const x=stats(filtered(m));return `<tr><td>${monthLabel(m)}</td><td>${x.done}</td>${x.sum.map(v=>'<td>$'+money(v)+'</td>').join('')}<td>$${money(x.total)}</td></tr>`;}).join('');$('summaryTotal').innerHTML=`<tr><td>全期合計</td><td>${g.done}</td>${g.sum.map(v=>'<td>$'+money(v)+'</td>').join('')}<td>$${money(g.total)}</td></tr>`;controls();}\nasync function update(){if(!connected||busy){data=JSON.parse(JSON.stringify(confirmed));render();return;}const next=normalize(data),expected=revision;busy=true;render();msg('正在儲存…');try{apply(await rpc('save',{revision:expected,records:next}));msg('已儲存至 Google 試算表',true);}catch(e){data=JSON.parse(JSON.stringify(confirmed));connected=false;msg('未確認儲存：'+e.message);alert('本次變更未確認儲存，將重新讀取雲端紀錄。');}finally{busy=false;render();if(!connected)refresh();}}\n$('tabs').addEventListener('click',e=>{const b=e.target.closest('[data-month]');if(b){selected=b.dataset.month;render();}});\n$('rows').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.date){const r=data.find(x=>x.date===b.dataset.date);if(!r||r.off)return;const i=Number(b.dataset.person);r.status[i]={U:'P',P:'A',A:'U'}[r.status[i]];update();}else if(b.dataset.off){const r=data.find(x=>x.date===b.dataset.off);if(r&&!r.off&&state(r)==='done'&&!confirm('此課已結算，停課會移除當日薪資。確定？'))return;if(r){r.off=!r.off;update();}}else if(b.dataset.edit){openEditor(b.dataset.edit);}});\n$('rows').addEventListener('change',e=>{if(!e.target.dataset.rate)return;const r=data.find(x=>x.date===e.target.dataset.rate),v=e.target.valueAsNumber;if(!r||!Number.isInteger(v)||v<0||v>1000000){render();alert('請輸入 0～1,000,000 的整數金額');return;}r.rate=v;update();});\n$('allPresent').onclick=()=>{if(!confirm('將目前選取月份中尚未登記的個人狀態設為出席？已登記的請假不會變更。'))return;filtered(selected).forEach(r=>{if(!r.off)r.status=r.status.map(x=>x==='U'?'P':x);});update();};\nfunction openEditor(date){editing=date||null;const r=data.find(x=>x.date===date);$('edtitle').textContent=r?'編輯課程':'新增上課日期';$('date').value=r?r.date:(selected==='all'?'':selected+'-01');$('rate').value=r?r.rate:1920;$('note').value=r?r.note:'';$('editerror').textContent='';$('editor').showModal();}\n$('add').onclick=()=>openEditor(null);$('closeedit').onclick=()=>$('editor').close();$('editform').onsubmit=e=>{e.preventDefault();const date=$('date').value,rate=$('rate').valueAsNumber,note=$('note').value.trim();if(!validDate(date)||!Number.isInteger(rate)||rate<0||rate>1000000){$('editerror').textContent='請確認日期和金額。';return;}if(data.some(r=>r.date===date&&r.date!==editing)){$('editerror').textContent='此日期已有紀錄。';return;}if(editing){const r=data.find(x=>x.date===editing);Object.assign(r,{date,rate,note});}else data.push({date,rate,note,status:['U','U','U'],off:false});data.sort((a,b)=>a.date.localeCompare(b.date));selected=date.slice(0,7);$('editor').close();update();};\nfunction download(name,content,type){const url=URL.createObjectURL(new Blob([content],{type}));const a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),3000);}\n$('backup').onclick=()=>download('社團鐘點費備份.json',JSON.stringify({version:1,records:data},null,2),'application/json;charset=utf-8');$('restore').onclick=()=>$('file').click();$('file').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const x=JSON.parse(await f.text());const a=normalize(x.records);if(confirm('匯入將取代目前所有紀錄，確定繼續？')){data=a;update();}}catch(err){alert('匯入失敗：'+err.message);}e.target.value='';};$('reset').onclick=()=>{if(confirm('還原將清除後續修改並恢復原始出席與預排日期，確定？')){data=seed();selected='2026-12';update();}};\nconst csvCell=v=>{let s=String(v);if(/^[=+\\-@\\t\\r]/.test(s))s=\"'\"+s;return '\"'+s.replace(/\"/g,'\"\"')+'\"';};$('csv').onclick=()=>{const lines=[['日期','鐘點費',...names.map(n=>n+'狀態'),...names.map(n=>n+'應領'),'結算狀態','備註']];const l={P:'出席',A:'請假',U:'待登記'};data.forEach(r=>{const s=state(r);lines.push([r.date,r.rate,...r.status.map(x=>r.off?'停課':l[x]),...shares(r),s==='done'?'已結算':s==='off'?'停課':'待登記',r.note]);});lines.push([],['月份','已結算堂數',...names,'總額']);months().forEach(m=>{const x=stats(filtered(m));lines.push([monthLabel(m),x.done,...x.sum,x.total]);});const x=stats(data);lines.push(['全期合計',x.done,...x.sum,x.total]);download('社團鐘點費結算.csv','\\uFEFF'+lines.map(r=>r.map(csvCell).join(',')).join('\\r\\n'),'text/csv;charset=utf-8');};\ncontrols();\n</script></body></html>";
